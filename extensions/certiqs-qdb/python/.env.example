# Postgres URL supplied by the certiqs-qdb extension host (HQ Settings → QDB).
# For a manual uvicorn run, copy these into the process environment.
DATABASE_URL=

# Shared HS256 secret. The extension host mints Internal JWTs with this value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_AUTH_SECRET=

# Seconds before a minted internal token expires (default 60).
INTERNAL_AUTH_TTL_SECONDS=60

# DEV-ONLY. Set to 1 to route queries through Neon SQL-over-HTTPS.
# Create/resync need a real Postgres connection. Leave unset in normal use.
# NEON_HTTP_FALLBACK=1
