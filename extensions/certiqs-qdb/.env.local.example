# Parameter names for certiqs-qdb. Values belong in certiqs Settings
# (HQ Settings → QDB) or OS secret storage — never in this file.
#
# The old Next.js/Clerk/Vercel names are mapped as follows.
# Clerk is not used: the extension host is the identity provider.

# DATABASE_URL                 → secret  certiqs.qdb.databaseUrl
# INTERNAL_AUTH_SECRET         → secret  certiqs.qdb.internalAuthSecret
# INTERNAL_AUTH_TTL_SECONDS    → setting certiqs.qdb.internalAuthTtlSeconds (default 60)
# NEON_HTTP_FALLBACK           → setting certiqs.qdb.neonHttpFallback
# PY_BACKEND_URL               → host-owned. Use certiqs.qdb.port (default 8012 on 127.0.0.1)
#
# Optional / unused by the FastAPI engines (stored for host-side tools):
# NEO4J_URI                    → setting certiqs.qdb.neo4jUri
# NEO4J_USERNAME               → setting certiqs.qdb.neo4jUsername
# NEO4J_PASSWORD               → secret  certiqs.qdb.neo4jPassword
# ANTHROPIC_API_KEY            → secret  certiqs.qdb.anthropicApiKey
# VOYAGE_API_KEY               → secret  certiqs.qdb.voyageApiKey
# AI_GATEWAY_API_KEY           → secret  certiqs.qdb.aiGatewayApiKey
# AI_GATEWAY_BASE_URL          → setting certiqs.qdb.aiGatewayBaseUrl
#
# Left behind (web-app hosting / auth vendors):
# NODE_ENV, REACT_APP_VERSION, GENERATE_SOURCEMAP
# NEXT_PUBLIC_CLERK_*, CLERK_SECRET_KEY
# BLOB_READ_WRITE_TOKEN, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_APP_API_URL
