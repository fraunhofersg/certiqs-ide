{
	"name": "certiqs-theme",
	"displayName": "certiqs Theme",
	"description": "Certiqs Dark workbench theme and the shared webview design tokens used by certiqs-hq, certiqs-sim, and certiqs-qdb.",
	"version": "0.0.1",
	"publisher": "certiqs",
	"license": "MIT",
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"id": "Certiqs Dark",
				"label": "Certiqs Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/certiqs-dark.json"
			}
		],
		"configurationDefaults": {
			"workbench.colorTheme": "Certiqs Dark",
			"workbench.preferredDarkColorTheme": "Certiqs Dark",
			"workbench.activityBar.compact": true
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/fraunhofersg/certiqs-ide.git"
	}
}
